# Published evidence and its dependency lock have byte-exact SHA-256 records.
results/**/*.json text eol=lf
results/**/*.jsonl text eol=lf
results/rival2/human_demo_review_v1/REVIEW.md text eol=lf
results/rival2/human_demo_bc_bridge_v1/README.md text eol=lf
results/rival2/human_demo_bc_bridge_v1/simulator_corpus/*.npy binary
checkpoints/rival2/120hz_distilled/*.pt binary
benchmarks/review_rival2_human_demos.py text eol=lf
tests/test_human_demo_review.py text eol=lf
requirements-v0.1.txt text eol=lf
requirements-v0.2.txt text eol=lf
# This generated diagnostic patch must preserve the pinned binding source's
# existing mixed whitespace byte-for-byte because its SHA-256 is authority input.
tools/rocketsim_phase_c_order_probe.patch text eol=lf -whitespace
# Native packet evidence includes hashes of the original JSON bytes as well as
# binary captures; preserve those bytes instead of normalizing their newlines.
results/rival2/entity_native_packet_v1/reference600_blue/* -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/rival2/entity_native_reset_v2/reference600_blue/* -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/rival2/entity_native_reset_v2/reference600_orange/* -text whitespace=trailing-space,space-before-tab,cr-at-eol
# This lane binds raw JSON artifact SHA-256 values in selection/checkpoints.
# Preserve captured bytes; its source-code identities use normalized text hashes.
results/rival2/direct_skills_native_nexto_v1/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
# The closed training-log prefixes also bind their original append bytes.
results/rival2/direct_skills_native_nexto_v1/*.jsonl -text whitespace=trailing-space,space-before-tab,cr-at-eol
