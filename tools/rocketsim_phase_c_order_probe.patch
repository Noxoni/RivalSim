+PyObject *Arena::GetPreTickVisitOrder (Arena *self_) noexcept
+{
+	auto const &cars = self_->arena->GetCars ();
+	auto list = PyObjectRef::steal (PyList_New (cars.size ()));
+	if (!list)
+		return nullptr;
+
+	unsigned index = 0;
+	for (auto const *car : cars)
+	{
+		// Return only RocketSim's stable logical ID. Pointer values and hash
+		// bucket details are intentionally neither exposed nor serialized.
+		if (PyList_SetItem (list.borrow (), index++, PyLong_FromUnsignedLong (car->id)) < 0)
+			return nullptr;
+	}
+
+	return list.gift ();
+}
+
 PyObject *Arena::GetConfig (Arena *self_) noexcept
 {
 	return ArenaConfig::NewFromArenaConfig (self_->arena->GetArenaConfig ()).giftObject ();
